# Full-stack environment – Saga + Saga UI
# Copy to .env.full and fill in all values marked with ← CHANGE
#
#   cp .env.full.example .env.full
#   docker compose -f docker-compose.full.yml --env-file .env.full up -d

# ═══════════════════════════════════════════════════════════════════════════════
# Saga UI (BFF)
# ═══════════════════════════════════════════════════════════════════════════════

# Login credentials for the UI
UI_USERNAME=admin
UI_PASSWORD=change-me-please           # ← CHANGE

# Secret key for signing session cookies (min 32 chars, random)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-please-generate-a-real-random-secret!!   # ← CHANGE

# Session lifetime (seconds); default 8 h
SESSION_MAX_AGE=28800

# Maximum single-file upload size (bytes); default 100 MB
MAX_UPLOAD_BYTES=104857600

# Host port for the Saga UI (default: 8088)
BFF_PORT=8088

# Optional: override host ports for admin UIs (change if ports are already in use)
# OPENSEARCH_DASHBOARDS_PORT=5601
# MINIO_CONSOLE_PORT=9001
# OLLAMA_PORT=11434

# Optional: enable the Statistics tab's Agents section
AGENTS_BASE_URL=
AGENTS_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════════
# Saga API
# ═══════════════════════════════════════════════════════════════════════════════

# Bearer tokens accepted by the Saga REST API (comma-separated).
# The UI BFF uses the first/only token automatically.
SAGA_API_TOKENS=change-me-please  # ← CHANGE

# Saga host port (default: 8000)
API_PORT=8000
MCP_PORT=8100

SAGA_ENV=development
LOG_LEVEL=INFO
LOG_RENDERER=console

# CORS – '*' is fine when the UI BFF is the only consumer.
API_CORS_ALLOW_ORIGINS=*
API_CORS_ALLOW_CREDENTIALS=true

# ═══════════════════════════════════════════════════════════════════════════════
# OpenSearch
# ═══════════════════════════════════════════════════════════════════════════════

OPENSEARCH_USERNAME=admin
# Must satisfy OpenSearch's strong-password policy (uppercase, number, special char).
OPENSEARCH_PASSWORD=Str0ng!OpenSearch#Pass   # ← CHANGE

# ═══════════════════════════════════════════════════════════════════════════════
# MinIO (object storage)
# ═══════════════════════════════════════════════════════════════════════════════

MINIO_ACCESS_KEY=saga
MINIO_SECRET_KEY=change-me-minio-secret   # ← CHANGE

# ═══════════════════════════════════════════════════════════════════════════════
# Document conversion (Docling / Kreuzberg)
# ═══════════════════════════════════════════════════════════════════════════════

# Maximum seconds Docling will spend converting a single document before it
# returns HTTP 504 (server-side limit). The Saga client timeout in
# config/converters.yaml (timeout_seconds: 600) must be higher than this value
# so Saga always gets a proper error response instead of a silent timeout.
# Increase for very large PDFs or slow CPU-only machines.
DOCLING_MAX_SYNC_WAIT=540

# ═══════════════════════════════════════════════════════════════════════════════
# LLM / Embeddings provider
# ═══════════════════════════════════════════════════════════════════════════════

# Options: ollama | openai | azure
LLM_PROVIDER=ollama
EMBEDDINGS_PROVIDER=ollama

# ── Ollama (default – runs in a container, no API key needed) ─────────────────
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# After first start, pull models once:
#   docker compose -f docker-compose.full.yml exec ollama ollama pull llama3.1:8b
#   docker compose -f docker-compose.full.yml exec ollama ollama pull nomic-embed-text

# ── OpenAI (set LLM_PROVIDER / EMBEDDINGS_PROVIDER=openai to activate) ────────
# OPENAI_API_KEY=sk-...
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Azure OpenAI (set providers=azure to activate) ────────────────────────────
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_LLM_DEPLOYMENT=
# AZURE_OPENAI_EMBED_DEPLOYMENT=

# ═══════════════════════════════════════════════════════════════════════════════
# Langfuse (optional LLM observability — leave empty to disable)
# Get keys from Langfuse UI → Settings → API Keys (free tier available at
# https://cloud.langfuse.com or self-host: https://github.com/langfuse/langfuse)
# ═══════════════════════════════════════════════════════════════════════════════
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud (default): https://cloud.langfuse.com
# US cloud:           https://us.cloud.langfuse.com
# Self-hosted:        http://your-host:3000
LANGFUSE_HOST=https://cloud.langfuse.com

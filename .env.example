# Saga UI – example environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Saga connection (can be on a different server) ---
SAGA_BASE_URL=http://localhost:8000
SAGA_API_TOKEN=change-me

# --- Static UI credentials ---
UI_USERNAME=admin
UI_PASSWORD=change-me

# --- Session (BFF) ---
SESSION_SECRET=please-generate-a-long-random-string
SESSION_MAX_AGE=28800

# --- Limits / misc ---
MAX_UPLOAD_BYTES=104857600
LOG_LEVEL=INFO
# BFF port (default: 8088; must match Vite proxy config and Docker setup)
# BFF_PORT=8088

# --- Only needed when the frontend is hosted on a different origin ---
# CORS_ALLOW_ORIGINS=https://ui.example.com
